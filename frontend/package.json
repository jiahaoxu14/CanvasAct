{
	"name": "canvasact-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check:agent-variants": "esbuild scripts/check-agent-variants.ts --bundle --platform=node --format=esm --outfile=.tsbuild/check-agent-variants.mjs && node .tsbuild/check-agent-variants.mjs",
		"dev": "vite",
		"eval:canvas-agent": "esbuild scripts/run-canvas-agent-evals.ts --bundle --platform=node --format=esm --outfile=.tsbuild/run-canvas-agent-evals.mjs && node .tsbuild/run-canvas-agent-evals.mjs",
		"eval:model-in-loop": "esbuild scripts/run-model-in-loop-evals.ts --bundle --platform=node --format=esm --outfile=.tsbuild/run-model-in-loop-evals.mjs && node .tsbuild/run-model-in-loop-evals.mjs",
		"preview": "vite preview"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^2.0.2",
		"@ai-sdk/google": "^2.0.14",
		"@ai-sdk/openai": "^2.0.24",
		"@cloudflare/vite-plugin": "^1.13.2",
		"@google/generative-ai": "^0.24.1",
		"@tldraw/tlschema": "^4.5.8",
		"@worker-tools/json-stream": "^0.1.0-pre.12",
		"ai": "^5.0.63",
		"best-effort-json-parser": "^1.1.3",
		"itty-router": "^5.0.18",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-markdown": "^10.1.0",
		"tldraw": "^4.5.8",
		"wrangler": "^4.67.0",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250913.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^3.10.2",
		"typescript": "^5.8.3",
		"vite": "^7.0.1"
	}
}
